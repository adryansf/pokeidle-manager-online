# Configuração básica do servidor do painel. TODO o resto (contas, proxy, Discord,
# Telegram, fuso etc.) é feito pelo painel, na aba "Configurações".

# Onde o painel escuta. 127.0.0.1 = só neste computador (recomendado localmente).
# Em Docker / Dokploy usa-se 0.0.0.0 (já configurado no Dockerfile) com TRUST_PROXY=1.
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8080

# Secret / Chave de proteção do painel (RECOMENDADO em VPS / Dokploy com domínio HTTPS).
# Quando definida, bloqueia o modo de "setup inicial aberto" e exige este secret logo no 1º acesso
# (funciona como senha de login no navegador e como `Authorization: Bearer <token>` na API).
TELEMETRY_TOKEN=

# Domínio HTTPS público onde o painel ficará acessível (ex.: https://pokeidle.seudominio.com).
PUBLIC_URL=

# Gateways de notificação opcionais (podem ser usados juntos ou separados e editados pelo painel):
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pasta dos dados (banco SQLite com as contas, tokens e estados). Padrão: ./data (ou /data no Docker)
# DATA_DIR=./data

# Origens permitidas para o dashboard em outro domínio (CORS), separadas por vírgula.
TELEMETRY_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Migração: se você já usava o formato antigo (ACC1_NICK, ACC1_TOKEN, ...),
# deixe essas variáveis aqui UMA vez: na 1ª execução elas são importadas para o
# banco, e depois o painel passa a mandar. Veja o README.
